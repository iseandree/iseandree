  lines:
  - speaker: {fileID: 11400000, guid: f62feed86ab7ddd49912a4dcf6b990ef, type: 2}
    text: Hello Young One.
  - speaker: {fileID: 11400000, guid: f62feed86ab7ddd49912a4dcf6b990ef, type: 2}
    text: It is good to see you today
  - speaker: {fileID: 11400000, guid: f62feed86ab7ddd49912a4dcf6b990ef, type: 2}
    text: Go see Malume she has a request for you.
  - speaker: {fileID: 11400000, guid: f62feed86ab7ddd49912a4dcf6b990ef, type: 2}
    text: Go see Malume she has a request for you.
  - speaker: {fileID: 11400000, guid: 7c194a158cc2173458542d9746ded9ad, type: 2}
    text: Ok will do!
